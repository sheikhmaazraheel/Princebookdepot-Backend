PORT=3000
MONGODB_URI=mongodb+srv://...
FRONTEND_ORIGIN=https://sheikhmaazraheel.github.io
CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...
MAX_IMAGE_MB=5

# Admin authentication
ADMIN_USERNAME=your-admin-username
# Generate with: node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');c.scrypt(process.env.ADMIN_PASSWORD,s,64,(e,k)=>console.log('ADMIN_PASSWORD_HASH=scrypt$'+s+'$'+k.toString('hex')))"
ADMIN_PASSWORD_HASH=scrypt$generated-salt$generated-key
# Use a long random value, at least 32 characters.
AUTH_SECRET=replace-with-a-long-random-secret

# WhatsApp Cloud API
WHATSAPP_API_VERSION=v25.0
WHATSAPP_ACCESS_TOKEN=your-meta-system-user-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-business-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-random-webhook-verification-token
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_CONFIRMATION_TEMPLATE=order_confirmation
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_ADMIN_PHONE=923xxxxxxxxx
# Optional: use an approved template for the admin alert when outside a 24-hour window.
WHATSAPP_ADMIN_ALERT_TEMPLATE=order_admin_alert
